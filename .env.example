# GitHub - Personal Access Token (repo scope)
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_xxx

# Notion - Internal Integration Secret
# Create at: https://www.notion.so/my-integrations
# Share your blog database/page with the integration
NOTION_API_KEY=ntn_xxx

# Notion - Parent page or database ID for new blog posts
# Get from the page URL: notion.so/workspace/PAGE_ID?v=...
NOTION_BLOG_PARENT_ID=xxx

# Notion - Set to "database" if parent is a database; "page" (default) if it's a page
NOTION_PARENT_TYPE=page

# OpenAI - API Key for content generation
# Get at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxx

# Optional: Vercel cron secret (for securing /api/generate-blog and /api/generate-blog-daily)
CRON_SECRET=your-random-secret
# Optional: Separate secret for Twitter cron (/api/generate-twitter-posts). If set, only this secret works for Twitter; if unset, CRON_SECRET is used.
# TWITTER_CRON_SECRET=

# Optional: Dev.to API key – auto-publish to Dev.to
# Get at: https://dev.to/settings/extensions
DEVTO_API_KEY=

# Optional: Medium Integration token – auto-publish to Medium
# Note: Medium no longer issues new tokens (existing ones still work).
# If you have one: https://medium.com/me/settings/security → Integration tokens
MEDIUM_API_KEY=
# Optional: Medium user id (skips /me call if set; we fetch from /me if omitted)
# MEDIUM_USER_ID=

# Optional: Override site URL for RSS/canonical (default: Vercel URL)
# SITE_URL=https://your-blog.com

# Optional: Twitter/X – per-account keys (see config/twitter.json). OAuth 1.0a: API Key = Consumer Key, API Secret = Consumer Key Secret.
# BountyHub (https://bountyhub.tech)
# TWITTER_BOUNTYHUB_API_KEY=
# TWITTER_BOUNTYHUB_API_SECRET=
# TWITTER_BOUNTYHUB_ACCESS_TOKEN=
# TWITTER_BOUNTYHUB_ACCESS_SECRET=
# Dice Express (https://dice.express)
# TWITTER_DICE_EXPRESS_API_KEY=
# TWITTER_DICE_EXPRESS_API_SECRET=
# TWITTER_DICE_EXPRESS_ACCESS_TOKEN=
# TWITTER_DICE_EXPRESS_ACCESS_SECRET=
# If no per-account message: tweets are auto-generated (project + recent commits, emojis, playful tone). Requires OPENAI_API_KEY and GITHUB_TOKEN.
# TWITTER_DEFAULT_MESSAGE=
