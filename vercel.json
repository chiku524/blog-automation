{
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/post/:id", "destination": "/post.html?id=:id" }
  ],
  "crons": [
    {
      "path": "/api/generate-blog",
      "schedule": "0 14 * * 5"
    },
    {
      "path": "/api/generate-blog-daily",
      "schedule": "59 23 * * *"
    },
    {
      "path": "/api/generate-twitter-posts",
      "schedule": "0 12 * * 0,1,3,5"
    }
  ]
}
